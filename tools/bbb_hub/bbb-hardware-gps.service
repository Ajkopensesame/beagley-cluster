[Unit]
Description=BBB vehicle_state hub with hardware GPS
After=network-online.target
Wants=network-online.target
# Appliance: never give up restarting (default limit is 5 starts per 10 s).
StartLimitIntervalSec=0

[Service]
# Type=notify + WatchdogSec need a hub that includes tools/bbb_hub/sd_notify.py (sends READY=1 / WATCHDOG=1).
# DEPLOY ORDER: ship the new hub code first, then this unit. See docs/bbb_deploy_rollback.md.
Type=notify
NotifyAccess=main
TimeoutStartSec=60
WatchdogSec=15
User=debian
Group=debian
WorkingDirectory=/home/debian/projects/beagley-cluster/tools/bbb_hub
Environment=PYTHONUNBUFFERED=1
Environment=BBB_HUB_HOST=0.0.0.0
Environment=BBB_HUB_PORT=8765
Environment=GPS_SOURCE_POLICY=hardware_only
EnvironmentFile=-/etc/default/bbb-hardware-gps
ExecStart=/bin/bash /home/debian/projects/beagley-cluster/tools/bbb_hub/run_prod.sh
Restart=always
RestartSec=2
# Cap runaway logging so a fault loop cannot fill the flash.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=2000
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
