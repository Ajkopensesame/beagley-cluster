BBB_GPS_DEVICE=/dev/ttyS4
BBB_GPS_BAUD=9600
BBB_GPS_READ_TIMEOUT_MS=200
BBB_GPS_STALE_MS=2000
BBB_GPS_MIN_HEADING_SPEED_KPH=7.0

# Bench UI mode. Keep hardware GPS/live maps, but synthesize vehicle/CAN-like
# speed, rpm, fuel, coolant, gear, warning, indicator, and drivetrain fields.
# Production hardware mode should leave this off and use CAN/serial inputs below.
# BBB_VEHICLE_BENCH_SIM=1

# Optional milestone-one CAN decoder replay overlay. Leave unset for normal GPS-only production behavior.
# CAN_SIGNAL_DICTIONARY=/home/debian/can_signals.json
# CAN_RAW_LOG=/home/debian/candump.log
# CAN_REPLAY_REPEAT=1

# Optional live CAN receive via Linux SocketCAN. Requires a configured CAN interface such as can0.
# CAN_SIGNAL_DICTIONARY=/home/debian/can_signals.json
# CAN_LIVE_INTERFACE=can0
# CAN_STALE_MS=1000
# CAN_EXPERT_DIAGNOSTICS_ENABLED=1

# Optional Arduino/optocoupler input module over serial USB.
# Protocol examples:
#   brake=1,oil=0,left=on,rpm=1200,speed=35.5
#   {"brake":true,"left":true,"speed":42.5}
# VEHICLE_INPUT_SERIAL_DEVICE=/dev/ttyACM0
# VEHICLE_INPUT_SERIAL_BAUD=115200
# VEHICLE_INPUT_STALE_MS=1000

# Optional deterministic signal fault monitor. Emits _health.signalMonitor and _health.signalFaults.
# SIGNAL_HEALTH_ENABLED=1
# GPS_SPEED_DISAGREEMENT_KPH=18.0

# Optional normalized diagnostic surface for the BeagleY display.
# DIAGNOSTIC_MODE=normal

# Optional per-vehicle learned baseline monitor. Learns normal target-vs-context behavior
# from decoded signals and emits _health.vehicleBaseline findings when drift is repeated.
# VEHICLE_BASELINE_ENABLED=1
# VEHICLE_BASELINE_PATH=/var/lib/beagley-cluster/baselines/vehicle_baseline.json
# VEHICLE_BASELINE_SAVE_EVERY_SAMPLES=25
# VEHICLE_BASELINE_MIN_SAVE_INTERVAL_SECONDS=30.0

# Optional fault recorder. Writes JSON evidence packets when _health.signalFaults appears.
# FAULT_RECORDER_ENABLED=1
# FAULT_RECORDER_DIR=/var/log/beagley-cluster/faults
# FAULT_RECORDER_BUFFER_SECONDS=20.0
# FAULT_RECORDER_MAX_BUFFER_FRAMES=300
# FAULT_RECORDER_MIN_INTERVAL_SECONDS=10.0
