# Optional overrides for beagley_cluster.service
VEHICLE_HUB_WS_URL=ws://10.24.0.7:8765
BEAGLEY_UI_VARIANT=embedded
BEAGLEY_GPU_GATE_FILE=/tmp/beagley_gpu_gate.ok
BEAGLEY_PROFILE_METRICS=1
# Experimental. Safe to test because it falls back to native-online unless the
# image is built with PACKAGECONFIG:append:pn-beagley-cluster = " maplibre-native".
# MapLibre Native requires OpenGL scene graph rendering.
# QSG_RHI_BACKEND=opengl
# BEAGLEY_MAP_RENDERER=maplibre-native
# Safe compositor is the production default on the BeagleY EGLFS display.
# Full underlay is experimental because it can corrupt QML overlay surfaces.
# BEAGLEY_MAPLIBRE_NATIVE_FULL_UNDERLAY=0
# Promote a MapLibre style only after tools/maplibre/probe_beagley_style.sh
# proves it renders on the real BeagleY display.
# BEAGLEY_MAPLIBRE_NATIVE_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# BEAGLEY_MAPLIBRE_NATIVE_TRUSTED_STYLES=https://tiles.openfreemap.org/styles/positron
# BEAGLEY_MAPLIBRE_NATIVE_MAX_ZOOM=14
