[Unit]
Description=Beagley Cluster Display
Wants=network-online.target
After=network-online.target systemd-user-sessions.service

[Service]
Type=simple
User=__PROJECT_USER__
Group=__PROJECT_GROUP__
WorkingDirectory=__PROJECT_ROOT__
Environment=HOME=/home/__PROJECT_USER__
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QSG_RENDER_LOOP=basic
Environment=BEAGLEY_REQUIRE_GPU_GATE=1
Environment=BEAGLEY_UI_VARIANT=embedded
Environment=BEAGLEY_MAP_RENDERER=maplibre-native
Environment=BEAGLEY_MAPLIBRE_NATIVE_STYLE_URL=https://tiles.openfreemap.org/styles/positron
Environment=BEAGLEY_MAPLIBRE_NATIVE_TRUSTED_STYLES=https://tiles.openfreemap.org/styles/positron
Environment=BEAGLEY_MAPLIBRE_NATIVE_ALLOW_UNTESTED_STYLES=0
Environment=BEAGLEY_MAPLIBRE_NATIVE_FULL_UNDERLAY=0
Environment=BEAGLEY_MAPLIBRE_NATIVE_MAX_ZOOM=14.0
Environment=BEAGLEY_EFFECT_LEVEL=low
EnvironmentFile=-/etc/default/beagley-cluster
ExecStart=__PROJECT_ROOT__/tools/beagley_gpu/run_embedded_with_gate.sh
Restart=on-failure
RestartSec=3
SupplementaryGroups=video render input tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
