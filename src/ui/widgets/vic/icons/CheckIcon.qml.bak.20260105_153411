import QtQuick 2.15

Item {
    id: root
    width: 96
    height: 96

    // Injected by VicWarningIcon
    property color color: "red"

    readonly property real s: Math.min(width, height)
    readonly property real stroke: Math.max(3, s * 0.065)
    readonly property real r: Math.max(8, s * 0.14)   // very rounded

    // ============================
    // Continuous-outline illusion
    // ============================

    // Main rounded engine body
    Rectangle {
        id: body
        width: root.s * 0.72
        height: root.s * 0.36
        x: root.s * 0.14
        y: root.s * 0.46
        radius: root.r
        color: "transparent"
        border.width: root.stroke
        border.color: root.color
        opacity: 0.95
    }

    // Top rounded cap (overlaps body border)
    Rectangle {
        width: root.s * 0.44
        height: root.s * 0.14
        x: body.x + root.s * 0.14
        y: body.y - root.s * 0.12
        radius: root.r
        color: "transparent"
        border.width: root.stroke
        border.color: root.color
        opacity: 0.95
    }

    // Left rounded intake (merged into body)
    Rectangle {
        width: root.s * 0.18
        height: root.s * 0.24
        x: body.x - root.s * 0.12
        y: body.y + root.s * 0.05
        radius: root.r
        color: "transparent"
        border.width: root.stroke
        border.color: root.color
        opacity: 0.95
    }

    // Right exhaust curve (single rounded bar)
    Rectangle {
        width: root.s * 0.22
        height: root.stroke
        radius: height / 2
        color: root.color
        opacity: 0.95
        x: body.x + body.width - (width * 0.25)
        y: body.y + body.height * 0.50
    }

    // Bottom stabilizer (tiny, subtle)
    Rectangle {
        width: root.s * 0.18
        height: root.stroke
        radius: height / 2
        color: root.color
        opacity: 0.95
        x: body.x + root.s * 0.20
        y: body.y + body.height + root.s * 0.03
    }
}
