[Unit]
Description=Beagley Cluster GPU Probe
After=local-fs.target systemd-modules-load.service beagley-cluster-provision.service
Wants=beagley-cluster-provision.service
Before=beagley_cluster.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/beagley-cluster
EnvironmentFile=-/etc/default/beagley-cluster.local
ExecCondition=/bin/sh -c '! grep -Eq "(^| )beagley\\.diag=1($| )" /proc/cmdline && test ! -f /run/beagley-diagnostic.mode'
ExecStart=/usr/libexec/beagley-cluster/beagley-cluster-gpu-probe.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
