QT_QPA_PLATFORM=eglfs
QT_QPA_EGLFS_INTEGRATION=eglfs_kms
QSG_RENDER_LOOP=basic
BEAGLEY_UI_VARIANT=embedded
BEAGLEY_RENDER_PROFILE=embedded
BEAGLEY_EFFECT_LEVEL=low
BEAGLEY_GAUGE_DETAIL=safe
BEAGLEY_GAUGE_DEMO=0
BEAGLEY_MAP_RENDERER=maplibre-native
# Verified on the real BeagleY display by tools/maplibre/probe_beagley_style.sh.
# Keep untested styles disabled; change the URL only after a successful probe.
BEAGLEY_MAPLIBRE_NATIVE_STYLE_URL=https://tiles.openfreemap.org/styles/positron
BEAGLEY_MAPLIBRE_NATIVE_TRUSTED_STYLES=https://tiles.openfreemap.org/styles/positron,https://tiles.openfreemap.org/styles/liberty,https://tiles.openfreemap.org/styles/dark,https://tiles.openfreemap.org/styles/bright
BEAGLEY_MAPLIBRE_NATIVE_MAX_ZOOM=14.0
BEAGLEY_MAPLIBRE_NATIVE_FULL_UNDERLAY=1
BEAGLEY_MAPLIBRE_NATIVE_ALLOW_UNTESTED_STYLES=0
BEAGLEY_MAP_BOOT_MODE=staged
BEAGLEY_MAP_STYLE_MODE=embedded
BEAGLEY_REQUIRE_GPU_GATE=1
BEAGLEY_GPU_GATE_FILE=/run/beagley_gpu_gate.ok
BEAGLEY_GPU_PROBE_STATUS_FILE=/run/beagley_gpu_gate.status
BEAGLEY_GPU_PROBE_LOG_FILE=/run/beagley_gpu_gate.log
BEAGLEY_REQUIRE_TOUCH_GATE=0
BEAGLEY_TOUCH_GATE_FILE=/run/beagley_touch_gate.ok
BEAGLEY_TOUCH_PROBE_STATUS_FILE=/run/beagley_touch_gate.status
BEAGLEY_TOUCH_PROBE_LOG_FILE=/run/beagley_touch_gate.log
BEAGLEY_TOUCH_GATE_TIMEOUT=60
BEAGLEY_CLUSTER_HOSTNAME=beagley
BEAGLEY_WIFI_ONBOARDING=1
BEAGLEY_WIFI_WIZARD_TRIGGER=offline
VEHICLE_HUB_WS_URL=ws://10.24.0.7:8765
BEAGLEY_PROFILE_METRICS=0
# Real Spotify playback source. Secrets belong in /etc/default/beagley-cluster.local,
# not in this image default file. Required scopes for a refresh token:
# user-read-playback-state user-read-currently-playing user-modify-playback-state
BEAGLEY_NOW_PLAYING_BACKEND=spotify-web
BEAGLEY_NOW_PLAYING_SOURCE_LABEL=Spotify
BEAGLEY_NOW_PLAYING_REFRESH_MS=5000
# Optional long-term QR sign-in broker. Put the broker token in
# /etc/default/beagley-cluster.local, not in this image default file.
# BEAGLEY_SPOTIFY_BROKER_URL=https://spotify.pneumaion.com
