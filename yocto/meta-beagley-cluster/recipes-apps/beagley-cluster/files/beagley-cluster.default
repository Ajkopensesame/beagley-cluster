QT_QPA_PLATFORM=eglfs
QT_QPA_EGLFS_INTEGRATION=eglfs_kms
BEAGLEY_UI_VARIANT=embedded
BEAGLEY_RENDER_PROFILE=embedded
BEAGLEY_EFFECT_LEVEL=low
BEAGLEY_MAP_RENDERER=native-online
# Experimental renderer switch:
#   BEAGLEY_MAP_RENDERER=maplibre-native
# keeps native-online as a safe fallback unless the image is built with:
#   PACKAGECONFIG:append:pn-beagley-cluster = " maplibre-native"
# MapLibre Native requires OpenGL scene graph rendering.
#   QSG_RHI_BACKEND=opengl
# Safe compositor is the production default on BeagleY. Full underlay can let
# MapLibre leak through QML widgets on the EGLFS display and should only be
# enabled for deliberate renderer testing.
BEAGLEY_MAPLIBRE_NATIVE_FULL_UNDERLAY=0
# Keep MapLibre from blanking the cluster with untested production styles.
# Set to 1 only for deliberate renderer/style compatibility testing.
BEAGLEY_MAPLIBRE_NATIVE_ALLOW_UNTESTED_STYLES=0
# Production MapLibre styles must be promoted by the real-display probe before
# adding them to this allowlist. Leave blank to use the built-in demo baseline.
# BEAGLEY_MAPLIBRE_NATIVE_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# BEAGLEY_MAPLIBRE_NATIVE_TRUSTED_STYLES=https://tiles.openfreemap.org/styles/positron
# BEAGLEY_MAPLIBRE_NATIVE_MAX_ZOOM=14
BEAGLEY_MAP_BOOT_MODE=staged
BEAGLEY_MAP_STYLE_MODE=embedded
BEAGLEY_REQUIRE_GPU_GATE=1
BEAGLEY_GPU_GATE_FILE=/run/beagley_gpu_gate.ok
BEAGLEY_GPU_PROBE_STATUS_FILE=/run/beagley_gpu_gate.status
BEAGLEY_GPU_PROBE_LOG_FILE=/run/beagley_gpu_gate.log
BEAGLEY_REQUIRE_TOUCH_GATE=0
BEAGLEY_TOUCH_GATE_FILE=/run/beagley_touch_gate.ok
BEAGLEY_TOUCH_PROBE_STATUS_FILE=/run/beagley_touch_gate.status
BEAGLEY_TOUCH_PROBE_LOG_FILE=/run/beagley_touch_gate.log
BEAGLEY_TOUCH_GATE_TIMEOUT=60
BEAGLEY_CLUSTER_HOSTNAME=beagley
VEHICLE_HUB_WS_URL=ws://10.24.0.7:8765
BEAGLEY_PROFILE_METRICS=0
