[Match]
Driver=am65-cpsw-nuss
KernelCommandLine=!root=/dev/nfs

[Link]
RequiredForOnline=no

[Network]
# Keep the BBB/debug Ethernet leg reachable without installing a default route.
# Wi-Fi is the intended internet path for map tiles and other outbound traffic.
Address=10.24.0.46/24
LLMNR=yes
MulticastDNS=yes
