[Unit]
Description=Beagley Diagnostic Collector
After=beagley-cluster-provision.service beagley-diagnostic-local-fs.service
Wants=beagley-cluster-provision.service beagley-diagnostic-local-fs.service
Before=beagley-cluster-gpu-probe.service beagley-cluster.service

[Service]
Type=oneshot
ExecCondition=/bin/sh -c 'grep -Eq "(^| )beagley\\.diag=1($| )" /proc/cmdline || test -f /run/beagley-diagnostic.mode'
ExecStart=/usr/libexec/beagley-cluster/beagley-diagnostic.sh both multi-user-reached
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
