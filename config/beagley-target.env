# Machine-local BeagleY targets. Keep these aligned with the home-modem DHCP
# reservations:
#   beagley-ai-eth  c0:d6:0a:f9:55:1c  192.168.0.46
#   beagley-ai-wifi 10:ca:bf:d6:34:1a  192.168.0.92
#
# Order matters: use Ethernet when it is on the modem, then Wi-Fi when
# Ethernet is moved to the BBB, then mDNS as a last fallback.
BEAGLEY_TARGETS="root@192.168.0.46 root@192.168.0.92 root@beagley-ai.local"
BEAGLEY_HOST_NAME=beagley-ai.local
