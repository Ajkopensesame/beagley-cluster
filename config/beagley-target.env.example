# Example BeagleY target configuration (placeholder values only).
#
# Copy this file to config/beagley-target.env (which is gitignored) and edit it
# for your own network:
#
#   cp config/beagley-target.env.example config/beagley-target.env
#
# Never commit real IP addresses, MAC addresses, or credentials.
#
# Suggested approach: reserve fixed DHCP leases on your router for the board's
# interfaces, e.g.
#   beagley-ai-eth  <ETH_MAC_ADDRESS>   <ETH_IP_ADDRESS>
#   beagley-ai-wifi <WIFI_MAC_ADDRESS>  <WIFI_IP_ADDRESS>
#
# Order matters: list Ethernet first, then Wi-Fi, then the mDNS name as a last
# fallback.
BEAGLEY_TARGETS="root@192.0.2.10 root@192.0.2.11 root@beagley-ai.local"
BEAGLEY_HOST_NAME=beagley-ai.local
